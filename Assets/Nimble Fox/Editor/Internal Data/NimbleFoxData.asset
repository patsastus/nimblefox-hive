                Color preDawnCameraSkyColor = new Color(0.001f, 0.004f, 0.015f);"
            - SymbolID:
                Name: morningCameraSkyColor
                SymType: 0
                Signature: 
                IsStatic: 0
              SliceSpan: {x: 30, y: 30}
