                SymType: 1
                Signature: (AudioClip)
                IsStatic: 0
              SliceSpan: {x: 34, y: 40}
              Code: "\n    public void PlaySFX(AudioClip clip)\n    {\n        if
                (sfxSource != null && clip != null)\n        {\n            sfxSource.PlayOneShot(clip);\n       
                }\n    }"
            - SymbolID:
                Name: Play
                SymType: 1
                Signature: ()
                IsStatic: 0
              SliceSpan: {x: 43, y: 49}
              Code: "    \n    // Just use whatever is in the Audio Source\n    public
