                SliceSpan: {x: 24, y: 24}
                Code: '    public Transform rightTarget;'
              - SymbolID:
                  Name: flySpeed
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 25, y: 25}
                Code: '    public float flySpeed = 15f;'
              - SymbolID:
                  Name: rounds
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 27, y: 33}
                Code: "\n    [Header(\"Rounds\")]\n    public WordRound[] rounds
                  = new WordRound[]\n    {\n        new WordRound { word = \"Dew\",
                  leftCategory = \"Night\", rightCategory = \"Dawn\", isLeftCorrect
                  = false },\n        new WordRound { word = \"Shadow\", leftCategory
                  = \"Night\", rightCategory = \"Dawn\", isLeftCorrect = true },\n       
                  new WordRound { word = \"Rooster\", leftCategory = \"Night\", rightCategory
                  = \"Dawn\", isLeftCorrect = false }\n    };"
              - SymbolID:
                  Name: currentRoundIndex
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 35, y: 35}
                Code: "\n    private int currentRoundIndex = 0;"
              - SymbolID:
                  Name: centerOrigin
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 36, y: 36}
                Code: '    private Vector3 centerOrigin;'
              - SymbolID:
                  Name: isResolving
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 37, y: 37}
                Code: '    private bool isResolving = false;'
              - SymbolID:
                  Name: score
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 38, y: 38}
                Code: '    public int score = 0;'
              - SymbolID:
                  Name: Start
                  SymType: 1
                  Signature: ()
                  IsStatic: 0
                SliceSpan: {x: 40, y: 47}
                Code: "\n    void Start()\n    {\n        if (centerWordDisplay !=
                  null)\n        {\n            centerOrigin = centerWordDisplay.transform.position;\n       
                  }\n        LoadRound(0);\n    }"
              - SymbolID:
                  Name: Update
                  SymType: 1
                  Signature: ()
                  IsStatic: 0
                SliceSpan: {x: 49, y: 65}
                Code: "\n    void Update()\n    {\n        if (isResolving || currentRoundIndex
                  >= rounds.Length) return;\n\n        Keyboard keyboard = Keyboard.current;\n       
                  if (keyboard == null) return;\n\n        // Player input: Left
                  (A or Left Arrow), Right (D or Right Arrow)\n        if (keyboard.aKey.wasPressedThisFrame
                  || keyboard.leftArrowKey.wasPressedThisFrame)\n        {\n           
                  StartCoroutine(ResolveChoice(true));\n        }\n        else if
                  (keyboard.dKey.wasPressedThisFrame || keyboard.rightArrowKey.wasPressedThisFrame)\n       
                  {\n            StartCoroutine(ResolveChoice(false));\n        }\n   
                  }"
              - SymbolID:
                  Name: LoadRound
                  SymType: 1
                  Signature: (int)
                  IsStatic: 0
                SliceSpan: {x: 67, y: 82}
                Code: "\n    void LoadRound(int index)\n    {\n        if (index
                  >= rounds.Length)\n        {\n            centerWordDisplay.text
                  = \"FIRST LIGHT REACHED!\";\n            return;\n        }\n\n       
                  WordRound r = rounds[index];\n        centerWordDisplay.text =
                  r.word;\n        centerWordDisplay.transform.position = centerOrigin;\n       
                  centerWordDisplay.color = Color.white;\n\n        if (leftCategoryDisplay)
                  leftCategoryDisplay.text = r.leftCategory;\n        if (rightCategoryDisplay)
                  rightCategoryDisplay.text = r.rightCategory;\n    }"
              - SymbolID:
                  Name: ResolveChoice
                  SymType: 1
                  Signature: (bool)
                  IsStatic: 0
                SliceSpan: {x: 84, y: 120}
                Code: "\n    IEnumerator ResolveChoice(bool choseLeft)\n    {\n       
                  isResolving = true;\n        Transform target = choseLeft ? leftTarget
                  : rightTarget;\n        Vector3 targetPos = target != null ? target.position
                  : (centerOrigin + (choseLeft ? Vector3.left : Vector3.right) *
                  6f);\n\n        // Glide the word to the chosen side\n        while
                  (Vector3.Distance(centerWordDisplay.transform.position, targetPos)
                  > 0.1f)\n        {\n            centerWordDisplay.transform.position
                  = Vector3.MoveTowards(\n                centerWordDisplay.transform.position,
                  \n                targetPos, \n                flySpeed * Time.deltaTime\n           
                  );\n            yield return null;\n        }\n\n        // Evaluate
                  answer\n        bool isCorrect = (choseLeft == rounds[currentRoundIndex].isLeftCorrect);\n       
                  if (isCorrect)\n        {\n            score++;\n            centerWordDisplay.color
                  = Color.yellow; // Visual hit feedback\n            Debug.Log($\"Correct!
                  Score: {score}\");\n        }\n        else\n        {\n           
                  centerWordDisplay.color = Color.gray;\n            Debug.Log($\"Wrong!
                  Score: {score}\");\n        }\n\n        yield return new WaitForSeconds(0.4f);\n\n       
                  currentRoundIndex++;\n        LoadRound(currentRoundIndex);\n       
                  isResolving = false;\n    }"
