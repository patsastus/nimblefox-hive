                  return lineRenderer != null &&\n               projectileRigidbody
                  != null &&\n               projectileCollider != null &&\n              
                  aimingCamera != null;\n    }"
              - SymbolID:
                  Name: PointerHitsProjectile
                  SymType: 1
                  Signature: (Pointer)
                  IsStatic: 0
                SliceSpan: {x: 87, y: 96}
                Code: "\n    private bool PointerHitsProjectile(Pointer pointer)\n   
                  {\n        if (pointer == null || aimingCamera == null || projectileCollider
                  == null)\n        {\n            return false;\n        }\n\n       
                  Ray pointerRay = aimingCamera.ScreenPointToRay(pointer.position.ReadValue());\n       
                  return projectileCollider.Raycast(pointerRay, out _, Mathf.Infinity);\n   
                  }"
              - SymbolID:
                  Name: TryGetPointerPlanePosition
                  SymType: 1
                  Signature: (Pointer, out Vector3)
                  IsStatic: 0
                SliceSpan: {x: 98, y: 118}
                Code: "\n    private bool TryGetPointerPlanePosition(Pointer pointer,
                  out Vector3 planePosition)\n    {\n        planePosition = launchAnchor;\n\n       
                  if (pointer == null || aimingCamera == null)\n        {\n           
                  return false;\n        }\n\n        Ray pointerRay = aimingCamera.ScreenPointToRay(pointer.position.ReadValue());\n       
                  Plane aimingPlane = new Plane(Vector3.forward, launchAnchor);\n\n       
                  if (!aimingPlane.Raycast(pointerRay, out float rayDistance))\n       
                  {\n            return false;\n        }\n\n        planePosition
                  = pointerRay.GetPoint(rayDistance);\n        planePosition.z =
                  launchAnchor.z;\n        return true;\n    }"
              - SymbolID:
                  Name: BeginDrag
                  SymType: 1
                  Signature: (Vector3)
                  IsStatic: 0
                SliceSpan: {x: 120, y: 129}
                Code: "\n    private void BeginDrag(Vector3 pointerPosition)\n   
                  {\n        isDragging = true;\n\n        projectileRigidbody.isKinematic
                  = true;\n        projectileRigidbody.linearVelocity = Vector3.zero;\n       
                  projectileRigidbody.angularVelocity = Vector3.zero;\n\n       
                  UpdateDrag(pointerPosition);\n    }"
              - SymbolID:
                  Name: UpdateDrag
                  SymType: 1
                  Signature: (Vector3)
                  IsStatic: 0
                SliceSpan: {x: 131, y: 147}
                Code: "\n    private void UpdateDrag(Vector3 pointerPosition)\n   
                  {\n        Vector3 pullOffset = pointerPosition - launchAnchor;\n       
                  pullOffset.z = 0f;\n\n        float pullLimit = Mathf.Max(0f, maxPullDistance);\n       
                  if (pullOffset.sqrMagnitude > pullLimit * pullLimit)\n        {\n           
                  pullOffset = pullOffset.normalized * pullLimit;\n        }\n\n       
                  Vector3 projectilePosition = launchAnchor + pullOffset;\n       
                  projectilePosition.z = launchAnchor.z;\n\n        projectileRigidbody.position
                  = projectilePosition;\n        UpdateLine(projectilePosition);\n   
                  }"
              - SymbolID:
                  Name: ReleaseProjectile
                  SymType: 1
                  Signature: ()
                  IsStatic: 0
                SliceSpan: {x: 149, y: 169}
                Code: "\n    private void ReleaseProjectile()\n    {\n        isDragging
                  = false;\n        hasLaunched = true;\n\n        Vector3 launchEndpoint
                  = projectileRigidbody.position;\n        Vector3 launchDirection
                  = launchAnchor - launchEndpoint;\n        launchDirection.z = 0f;\n\n       
                  float pullDistance = launchDirection.magnitude;\n        Vector3
                  launchVelocity = pullDistance > 0f\n            ? launchDirection.normalized
                  * (pullDistance * launchVelocityScale)\n            : Vector3.zero;\n\n       
                  projectileRigidbody.isKinematic = false;\n        projectileRigidbody.useGravity
                  = true;\n        projectileRigidbody.linearVelocity = launchVelocity;\n       
                  projectileRigidbody.angularVelocity = Vector3.zero;\n\n       
                  StartCoroutine(RetractLine(launchEndpoint));\n    }"
              - SymbolID:
                  Name: UpdateLine
                  SymType: 1
                  Signature: (Vector3)
                  IsStatic: 0
                SliceSpan: {x: 171, y: 204}
                Code: "\n    private void UpdateLine(Vector3 endPoint)\n    {\n       
                  if (lineRenderer == null)\n        {\n            return;\n       
                  }\n\n        if (lineRenderer.positionCount != LinePointCount)\n       
                  {\n            lineRenderer.positionCount = LinePointCount;\n       
                  }\n\n        for (int i = 0; i < LinePointCount; i++)\n       
                  {\n            float t = i / (float)(LinePointCount - 1);\n           
                  Vector3 point;\n\n            if (i == 0)\n            {\n               
                  point = launchAnchor;\n            }\n            else if (i ==
                  LinePointCount - 1)\n            {\n                point = endPoint;\n           
                  }\n            else\n            {\n                point = Vector3.Lerp(launchAnchor,
                  endPoint, t);\n                point += Vector3.down * (Mathf.Sin(t
                  * Mathf.PI) * lineSag);\n            }\n\n            lineRenderer.SetPosition(i,
                  point);\n        }\n    }"
              - SymbolID:
                  Name: RetractLine
                  SymType: 1
                  Signature: (Vector3)
                  IsStatic: 0
                SliceSpan: {x: 206, y: 234}
                Code: "\n    private IEnumerator RetractLine(Vector3 launchEndpoint)\n   
                  {\n        if (lineRenderer == null)\n        {\n            yield
                  break;\n        }\n\n        if (lineRetractDuration <= 0f)\n       
                  {\n            CollapseLine();\n            yield break;\n       
                  }\n\n        float elapsed = 0f;\n\n        while (elapsed < lineRetractDuration)\n       
                  {\n            elapsed += Time.deltaTime;\n\n            float
                  progress = Mathf.Clamp01(elapsed / lineRetractDuration);\n           
                  float smoothProgress = Mathf.SmoothStep(0f, 1f, progress);\n           
                  Vector3 retractEndpoint = Vector3.Lerp(launchEndpoint, launchAnchor,
                  smoothProgress);\n\n            UpdateLine(retractEndpoint);\n           
                  yield return null;\n        }\n\n        CollapseLine();\n    }"
              - SymbolID:
                  Name: CollapseLine
                  SymType: 1
                  Signature: ()
                  IsStatic: 0
                SliceSpan: {x: 236, y: 252}
                Code: "\n    private void CollapseLine()\n    {\n        if (lineRenderer
                  == null)\n        {\n            return;\n        }\n\n       
                  if (lineRenderer.positionCount != LinePointCount)\n        {\n           
                  lineRenderer.positionCount = LinePointCount;\n        }\n\n       
                  for (int i = 0; i < LinePointCount; i++)\n        {\n           
                  lineRenderer.SetPosition(i, launchAnchor);\n        }\n    }"
