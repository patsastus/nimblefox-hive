            - _scriptNameRaw: Wordchooser
              Path: Wordchooser.cs
              _classNameRaw: SimpleWordChooser
              ExposedSlices:
              - SymbolID:
                  Name: sunriseLightingController
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 35, y: 35}
                Code: "\n    [SerializeField] private SunriseLightingController sunriseLightingController;"
              - SymbolID:
                  Name: Start
                  SymType: 1
                  Signature: ()
                  IsStatic: 0
                SliceSpan: {x: 42, y: 60}
                Code: "\n    void Start()\n    {\n        if (sunriseLightingController
                  == null)\n        {\n            TryGetComponent(out sunriseLightingController);\n       
                  }\n\n        if (sunriseLightingController != null)\n        {\n           
                  sunriseLightingController.Initialize(rounds != null ? rounds.Length
                  : 0, score);\n        }\n\n        if (centerWordDisplay != null)\n       
                  {\n            centerOrigin = centerWordDisplay.transform.position;\n       
                  }\n\n        LoadRound(0);\n    }"
              - SymbolID:
                  Name: ResolveChoice
                  SymType: 1
                  Signature: (bool)
                  IsStatic: 0
                SliceSpan: {x: 97, y: 139}
                Code: "\n    IEnumerator ResolveChoice(bool choseLeft)\n    {\n       
                  isResolving = true;\n        Transform target = choseLeft ? leftTarget
                  : rightTarget;\n        Vector3 targetPos = target != null ? target.position
                  : (centerOrigin + (choseLeft ? Vector3.left : Vector3.right) *
                  6f);\n\n        // Glide the word to the chosen side\n        while
                  (Vector3.Distance(centerWordDisplay.transform.position, targetPos)
                  > 0.1f)\n        {\n            centerWordDisplay.transform.position
                  = Vector3.MoveTowards(\n                centerWordDisplay.transform.position,
                  \n                targetPos, \n                flySpeed * Time.deltaTime\n           
                  );\n            yield return null;\n        }\n\n        // Evaluate
                  answer\n        bool isCorrect = (choseLeft == rounds[currentRoundIndex].isLeftCorrect);\n       
                  if (isCorrect)\n        {\n            score++;\n\n           
                  if (sunriseLightingController != null)\n            {\n               
                  sunriseLightingController.UpdateSuccessCount(score);\n           
                  }\n\n            centerWordDisplay.color = Color.yellow; // Visual
                  hit feedback\n            Debug.Log($\"Correct! Score: {score}\");\n       
                  }\n        else\n        {\n            centerWordDisplay.color
                  = Color.gray;\n            Debug.Log($\"Wrong! Score: {score}\");\n       
                  }\n\n        yield return new WaitForSeconds(0.4f);\n\n       
                  currentRoundIndex++;\n        LoadRound(currentRoundIndex);\n       
                  isResolving = false;\n    }"
              ExposedUsings:
