      - targetName: Wordchooser
        targetGameObjectId: 
        actionId: 75da1cdf-af9a-44ba-9605-39c3e70f0509
        exeType: ScriptModificationExe
        label:
          actionVerb: Modify
          targetName: Wordchooser
          valueCommand: 
          outputIcon: icon-script
        _objectModificationExe:
          ExeId: 
          OperationType: 0
          UndoGroupIndices: 
          TargetObjectId: 
          ObjectSettings:
            IsPrefab: -1
            Name: 
            Tag: 
            Layer: 
            ParentID: 
            SourceID: 
            Source:
              ID: 
              WithoutChildren: 0
            Active: -1
            Focus: 0
            Rotation:
              LookAtTargetXZ:
                Enabled: 0
                Value: 
              WorldRotationOverride:
                Enabled: 0
                Value: {x: 0, y: 0, z: 0}
            Placement:
              Mode: 0
              VerticalOffset: 0
              TargetObjectId: 
              HitOffset: {x: 0, y: 0, z: 0}
              ScreenshotId: 
              ScreenU: 0
