        _scriptModificationExe:
          ExeId: e9eabc6e-6474-486f-a532-7dd8785dcd2f
          OperationType: 3000
          CompletedExecutionPhases: 0
          _scriptAssignment:
            Name: SlingshotController.cs
            EnsureComponentExists: 1
            ScriptModificationId: 4ca9936b-f0e5-4531-851c-bfc55ea2cb0e
            ThisCreatedScript: 0
            ThisModifiedCode: 1
            ThisAppliedEnsurationChange: 0
            BackupCode: "using System.Collections;\nusing UnityEngine;\nusing UnityEngine.InputSystem;\n\npublic
              class SlingshotController : MonoBehaviour\n{\n    private const int
              LinePointCount = 20;\n\n    [SerializeField] private LineRenderer lineRenderer;\n   
              [SerializeField] private Rigidbody projectileRigidbody;\n    [SerializeField]
              private SphereCollider projectileCollider;\n    [SerializeField] private
              Camera aimingCamera;\n    [SerializeField] private float maxPullDistance
              = 3f;\n    [SerializeField] private float launchVelocityScale = 6f;\n   
              [SerializeField] private float lineRetractDuration = 0.25f;\n    [SerializeField]
              private float lineSag = 0.15f;\n\n    private Vector3 launchAnchor;\n   
              private bool isDragging;\n    private bool hasLaunched;\n\n    private
              void Start()\n    {\n        launchAnchor = transform.position;\n\n       
              if (lineRenderer != null)\n        {\n            lineRenderer.useWorldSpace
              = true;\n            lineRenderer.positionCount = LinePointCount;\n           
              CollapseLine();\n        }\n\n        if (projectileRigidbody != null)\n       
              {\n            projectileRigidbody.isKinematic = true;\n           
              projectileRigidbody.linearVelocity = Vector3.zero;\n            projectileRigidbody.angularVelocity
              = Vector3.zero;\n            projectileRigidbody.position = launchAnchor;\n       
              }\n    }\n\n    private void Update()\n    {\n        if (!HasRequiredReferences()
              || hasLaunched)\n        {\n            return;\n        }\n\n       
              Pointer pointer = Pointer.current;\n        if (pointer == null)\n       
              {\n            return;\n        }\n\n        if (isDragging)\n       
              {\n            if (pointer.press.wasReleasedThisFrame || !pointer.press.isPressed)\n           
              {\n                ReleaseProjectile();\n                return;\n           
              }\n\n            if (TryGetPointerPlanePosition(pointer, out Vector3
              pointerPosition))\n            {\n                UpdateDrag(pointerPosition);\n           
              }\n\n            return;\n        }\n\n        if (pointer.press.wasPressedThisFrame
              &&\n            PointerHitsProjectile(pointer) &&\n            TryGetPointerPlanePosition(pointer,
              out Vector3 dragStartPosition))\n        {\n            BeginDrag(dragStartPosition);\n       
              }\n    }\n\n    private bool HasRequiredReferences()\n    {\n       
              return lineRenderer != null &&\n               projectileRigidbody
              != null &&\n               projectileCollider != null &&\n              
              aimingCamera != null;\n    }\n\n    private bool PointerHitsProjectile(Pointer
              pointer)\n    {\n        if (pointer == null || aimingCamera == null
              || projectileCollider == null)\n        {\n            return false;\n       
              }\n\n        Ray pointerRay = aimingCamera.ScreenPointToRay(pointer.position.ReadValue());\n       
              return projectileCollider.Raycast(pointerRay, out _, Mathf.Infinity);\n   
              }\n\n    private bool TryGetPointerPlanePosition(Pointer pointer, out
              Vector3 planePosition)\n    {\n        planePosition = launchAnchor;\n\n       
              if (pointer == null || aimingCamera == null)\n        {\n           
              return false;\n        }\n\n        Ray pointerRay = aimingCamera.ScreenPointToRay(pointer.position.ReadValue());\n       
              Plane aimingPlane = new Plane(Vector3.forward, launchAnchor);\n\n       
              if (!aimingPlane.Raycast(pointerRay, out float rayDistance))\n       
              {\n            return false;\n        }\n\n        planePosition =
              pointerRay.GetPoint(rayDistance);\n        planePosition.z = launchAnchor.z;\n       
              return true;\n    }\n\n    private void BeginDrag(Vector3 pointerPosition)\n   
              {\n        isDragging = true;\n\n        projectileRigidbody.isKinematic
              = true;\n        projectileRigidbody.linearVelocity = Vector3.zero;\n       
              projectileRigidbody.angularVelocity = Vector3.zero;\n\n        UpdateDrag(pointerPosition);\n   
              }\n\n    private void UpdateDrag(Vector3 pointerPosition)\n    {\n       
              Vector3 pullOffset = pointerPosition - launchAnchor;\n        pullOffset.z
              = 0f;\n\n        float pullLimit = Mathf.Max(0f, maxPullDistance);\n       
              if (pullOffset.sqrMagnitude > pullLimit * pullLimit)\n        {\n           
              pullOffset = pullOffset.normalized * pullLimit;\n        }\n\n       
              Vector3 projectilePosition = launchAnchor + pullOffset;\n        projectilePosition.z
              = launchAnchor.z;\n\n        projectileRigidbody.position = projectilePosition;\n       
              UpdateLine(projectilePosition);\n    }\n\n    private void ReleaseProjectile()\n   
              {\n        isDragging = false;\n        hasLaunched = true;\n\n       
              Vector3 launchEndpoint = projectileRigidbody.position;\n        Vector3
              launchDirection = launchAnchor - launchEndpoint;\n        launchDirection.z
              = 0f;\n\n        float pullDistance = launchDirection.magnitude;\n       
              Vector3 launchVelocity = pullDistance > 0f\n            ? launchDirection.normalized
              * (pullDistance * launchVelocityScale)\n            : Vector3.zero;\n\n       
              projectileRigidbody.isKinematic = false;\n        projectileRigidbody.useGravity
              = true;\n        projectileRigidbody.linearVelocity = launchVelocity;\n       
              projectileRigidbody.angularVelocity = Vector3.zero;\n\n        StartCoroutine(RetractLine(launchEndpoint));\n   
              }\n\n    private void UpdateLine(Vector3 endPoint)\n    {\n       
              if (lineRenderer == null)\n        {\n            return;\n       
              }\n\n        if (lineRenderer.positionCount != LinePointCount)\n       
              {\n            lineRenderer.positionCount = LinePointCount;\n       
              }\n\n        for (int i = 0; i < LinePointCount; i++)\n        {\n           
              float t = i / (float)(LinePointCount - 1);\n            Vector3 point;\n\n           
              if (i == 0)\n            {\n                point = launchAnchor;\n           
              }\n            else if (i == LinePointCount - 1)\n            {\n               
              point = endPoint;\n            }\n            else\n            {\n               
              point = Vector3.Lerp(launchAnchor, endPoint, t);\n                point
              += Vector3.down * (Mathf.Sin(t * Mathf.PI) * lineSag);\n           
              }\n\n            lineRenderer.SetPosition(i, point);\n        }\n   
              }\n\n    private IEnumerator RetractLine(Vector3 launchEndpoint)\n   
              {\n        if (lineRenderer == null)\n        {\n            yield
              break;\n        }\n\n        if (lineRetractDuration <= 0f)\n       
              {\n            CollapseLine();\n            yield break;\n        }\n\n       
              float elapsed = 0f;\n\n        while (elapsed < lineRetractDuration)\n       
              {\n            elapsed += Time.deltaTime;\n\n            float progress
              = Mathf.Clamp01(elapsed / lineRetractDuration);\n            float
              smoothProgress = Mathf.SmoothStep(0f, 1f, progress);\n            Vector3
              retractEndpoint = Vector3.Lerp(launchEndpoint, launchAnchor, smoothProgress);\n\n           
              UpdateLine(retractEndpoint);\n            yield return null;\n       
              }\n\n        CollapseLine();\n    }\n\n    private void CollapseLine()\n   
              {\n        if (lineRenderer == null)\n        {\n            return;\n       
              }\n\n        if (lineRenderer.positionCount != LinePointCount)\n       
              {\n            lineRenderer.positionCount = LinePointCount;\n       
              }\n\n        for (int i = 0; i < LinePointCount; i++)\n        {\n           
              lineRenderer.SetPosition(i, launchAnchor);\n        }\n    }\n}"
