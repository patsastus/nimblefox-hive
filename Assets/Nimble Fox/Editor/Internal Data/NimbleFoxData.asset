              Code: '    private AudioSource sfxSource;'
            - SymbolID:
                Name: Awake
                SymType: 1
                Signature: ()
                IsStatic: 0
              SliceSpan: {x: 10, y: 32}
              Code: "    \n    void Awake()\n    {\n        if (Instance == null)\n       
                {\n            Instance = this;\n            DontDestroyOnLoad(gameObject);\n       
                }\n        else\n        {\n            Destroy(gameObject);\n           
                return;\n        }\n        \n        audioSource = GetComponent<AudioSource>();\n       
                if (audioSource == null)\n        {\n            audioSource = gameObject.AddComponent<AudioSource>();\n       
                }\n\n        sfxSource = gameObject.AddComponent<AudioSource>();\n       
                sfxSource.loop = false;\n        sfxSource.playOnAwake = false;\n   
                }"
            - SymbolID:
                Name: PlaySFX
                SymType: 1
                Signature: (AudioClip)
                IsStatic: 0
              SliceSpan: {x: 34, y: 40}
              Code: "\n    public void PlaySFX(AudioClip clip)\n    {\n        if
                (sfxSource != null && clip != null)\n        {\n            sfxSource.PlayOneShot(clip);\n       
                }\n    }"
            - SymbolID:
                Name: Play
                SymType: 1
                Signature: ()
                IsStatic: 0
              SliceSpan: {x: 43, y: 49}
              Code: "    \n    // Just use whatever is in the Audio Source\n    public
                void Play()\n    {\n        if (audioSource != null && !audioSource.isPlaying)\n       
                {\n            audioSource.Play();\n        }\n    }"
            - SymbolID:
                Name: SwitchBGM
                SymType: 1
                Signature: (AudioClip)
                IsStatic: 0
              SliceSpan: {x: 51, y: 60}
              Code: "\n    public void SwitchBGM(AudioClip newBGM)\n    {\n       
                if (audioSource != null && newBGM != null)\n        {\n           
                audioSource.Stop();\n            audioSource.clip = newBGM;\n           
                audioSource.loop = true;\n            audioSource.Play();\n       
                }\n    }"
            - SymbolID:
                Name: Stop
                SymType: 1
                Signature: ()
                IsStatic: 0
              SliceSpan: {x: 62, y: 68}
              Code: "    \n    public void Stop()\n    {\n        if (audioSource
                != null)\n        {\n            audioSource.Stop();\n        }\n   
                }"
            - SymbolID:
                Name: SetVolume
                SymType: 1
                Signature: (float)
                IsStatic: 0
              SliceSpan: {x: 70, y: 76}
              Code: "    \n    public void SetVolume(float volume)\n    {\n       
                if (audioSource != null)\n        {\n            audioSource.volume
                = Mathf.Clamp01(volume);\n        }\n    }"
