                SliceSpan: {x: 70, y: 76}
                Code: "    \n    public void SetVolume(float volume)\n    {\n       
                  if (audioSource != null)\n        {\n            audioSource.volume
                  = Mathf.Clamp01(volume);\n        }\n    }"
