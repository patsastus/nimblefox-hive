                  Name: candidateDistance
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 27, y: 29}
                Code: "\n    [Header(\"Candidate Word Settings\")]\n    [Tooltip(\"How
                  close to the camera the word floats\")]\n    public float candidateDistance
                  = 3f;"
              - SymbolID:
                  Name: candidateYOffset
                  SymType: 0
                  Signature: 
                  IsStatic: 0
                SliceSpan: {x: 30, y: 31}
                Code: "    [Tooltip(\"Slightly shift the word up or down relative
                  to camera center\")]\n    public float candidateYOffset = -0.5f;"
              - SymbolID:
                  Name: AlignToCamera
                  SymType: 1
                  Signature: ()
                  IsStatic: 0
                SliceSpan: {x: 33, y: 87}
                Code: "\n    [ContextMenu(\"Align Objects to Camera\")]\n    public
                  void AlignToCamera()\n    {\n        if (targetCamera == null)
                  targetCamera = Camera.main;\n        if (targetCamera == null)\n       
                  {\n            Debug.LogWarning(\"No camera assigned or found!\");\n           
                  return;\n        }\n\n        Transform camT = targetCamera.transform;\n\n       
                  // 1. Position Candidate Word (floating in front of camera)\n       
                  if (candidateWord != null)\n        {\n            candidateWord.position
                  = camT.position + (camT.forward * candidateDistance) + (camT.up
                  * candidateYOffset);\n            // Reset rotation to (0,0,0)
                  in the inspector\n            candidateWord.localRotation = Quaternion.identity;\n       
                  }\n\n        // 2. Calculate ground center position for targets\n       
                  Vector3 centerPoint = camT.position + (camT.forward * targetDistance);\n       
                  centerPoint.y = groundY; // Snap to the ground mesh height\n\n       
                  // Flatten the right vector so the spread is purely horizontal
                  (not tilted by camera pitch)\n        Vector3 flatRight = camT.right;\n       
                  flatRight.y = 0;\n        flatRight.Normalize();\n\n        //
                  3. Position Left Target & Label\n        if (leftTarget != null)\n       
                  {\n            leftTarget.position = centerPoint - (flatRight *
                  targetSpread);\n            leftTarget.localRotation = Quaternion.identity;
                  \n        }\n        if (leftLabel != null)\n        {\n           
                  leftLabel.position = leftTarget.position + (Vector3.up * labelHeightOffset);\n           
                  leftLabel.localRotation = Quaternion.identity; \n        }\n\n       
                  // 4. Position Right Target & Label\n        if (rightTarget !=
                  null)\n        {\n            rightTarget.position = centerPoint
                  + (flatRight * targetSpread);\n            rightTarget.localRotation
                  = Quaternion.identity;\n        }\n        if (rightLabel != null)\n       
                  {\n            rightLabel.position = rightTarget.position + (Vector3.up
                  * labelHeightOffset);\n            rightLabel.localRotation = Quaternion.identity;\n       
                  }\n\n        Debug.Log(\"Gameplay layout successfully snapped positions
                  and zeroed rotations!\");\n    }"
              ExposedUsings:
              - using UnityEngine;
              SliceSetPointer:
                ScriptName: GameplayLayout
                ScriptPath: Assets/Scripts/GameplayLayout.cs
                ClassName: GameplayLayout
                Symbols:
                - Name: targetCamera
                  SymType: -1
